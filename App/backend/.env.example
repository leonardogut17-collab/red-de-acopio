# Copia este archivo como .env y cambia los valores
PORT=4000
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=1h
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:3000
# Administrador inicial que crea "npm run seed"
ADMIN_EMAIL=admin@redacopio.co
ADMIN_PASSWORD=Admin12345
